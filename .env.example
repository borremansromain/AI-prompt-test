# Stock Management API — variables (Prompt 1.2)
# Copier vers .env pour executer l'app DIRECTEMENT sur l'hote
# (les services postgres/keycloak demarrés via : docker compose up -d postgres keycloak)

# ---- Application ----
SPRING_PROFILES_ACTIVE=dev
LOG_LEVEL=DEBUG

# ---- PostgreSQL (chemin hote : localhost) ----
DB_HOST=localhost
DB_PORT=5432
DB_NAME=stock_db
DB_USER=stock_user
DB_PASSWORD=secret_dev_only

# ---- Keycloak ----
KEYCLOAK_ISSUER=http://localhost:8081/realms/stock-app
JWT_JWKS_URI=http://localhost:8081/realms/stock-app/protocol/openid-connect/certs

# NOTE — si l'app tourne DANS le compose (docker compose up), le compose passe :
#   DB_HOST=postgres  (reseau compose, pas localhost)
#   KEYCLOAK_ISSUER=http://keycloak:8080/realms/stock-app
# (c'est exactement ce que fait docker-compose.yml)
